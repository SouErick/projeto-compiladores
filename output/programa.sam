ADDSP 3      // Aloca espaço para 3 variáveis
PUSHIMM 5    // Literal inteiro 5
STOREOFF 0   // Atribuição para 'x'
PUSHIMM 3    // Literal inteiro 3
STOREOFF 1   // Atribuição para 'y'
PUSHOFF 0    // Lê valor de 'x'
PUSHOFF 1    // Lê valor de 'y'
GREATER      // NoVariavel('x') > NoVariavel('y')
JUMPZ else0  // Pula se a condição for falsa
PUSHOFF 0    // Lê valor de 'x'
STOREOFF 2   // Atribuição para 'z'
JUMP endif1  // Pula o bloco else
else0:
PUSHOFF 1    // Lê valor de 'y'
STOREOFF 2   // Atribuição para 'z'
endif1:
ADDSP -3     // Libera espaço das variáveis
STOP         // Fim do programa