ADDSP 2      // Aloca espaço para 2 variáveis
PUSHIMM 5    // Literal inteiro 5
STOREOFF 0   // Atribuição para 'x'
PUSHOFF 0    // Lê valor de 'x'
PUSHIMM 6    // Literal inteiro 6
ADD          // NoVariavel('x') + NoLiteralInt(6)
STOREOFF 1   // Atribuição para 'y'
ADDSP -2     // Libera espaço das variáveis
STOP         // Fim do programa